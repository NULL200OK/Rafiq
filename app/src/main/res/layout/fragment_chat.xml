<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rafiq_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rafiq_primary_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingTop="10dp"
        android:paddingEnd="16dp" android:paddingBottom="10dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/status_online"
            android:textColor="#B2DFDB" android:textSize="12sp" />

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMode"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mode_menu"
            android:padding="6dp"
            android:text="🙂"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnMemory"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mem_title"
            android:padding="6dp"
            android:text="🧠"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:text="⚙"
            android:textColor="#FFFFFF" android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/faceContainer"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_face_panel"
        android:elevation="2dp">

        <com.rafiq.app.face.FaceView
            android:id="@+id/faceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnFaceEdit"
            android:layout_width="34dp" android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="@string/face_menu"
            android:gravity="center"
            android:text="📷"
            android:textSize="15sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#FFF3E0"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/offline_banner"
        android:textColor="#E65100" android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/trainerBanner"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#E3F2FD"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="#1565C0" android:textSize="12sp" android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="8dp" android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/typingRow"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="4dp"
        android:text="@string/typing"
        android:textColor="#78909C" android:textSize="13sp" android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvVoiceState"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="6dp"
        android:text="@string/listening"
        android:textColor="@color/rafiq_primary"
        android:textSize="14sp" android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/btnMic"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_circle_gray"
            android:padding="10dp"
            android:text="🎤" android:textSize="18sp" />

        <TextView
            android:id="@+id/btnSpeaker"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_circle_gray"
            android:contentDescription="@string/speaker_desc"
            android:padding="10dp"
            android:text="🔊" android:textSize="18sp" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/chat_input_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp" android:paddingTop="10dp"
            android:paddingEnd="14dp" android:paddingBottom="10dp"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="46dp" android:layout_height="46dp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="@string/send"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>